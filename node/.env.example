# ==========================================
# Server Monitoring Agent Configuration
# ==========================================
# Все переменные ниже читает node/app/config.py. Значения по умолчанию
# подходят для штатной установки — менять нужно только NODE_NAME.
#
# Авторизация здесь не настраивается: снаружи ноду закрывает nginx с mTLS
# (порт 9100), а сам агент слушает только 127.0.0.1:7500.

# Имя ноды в интерфейсе панели
NODE_NAME=node-01

# IP панели — под него открывается порт 9100 в UFW при установке
PANEL_IP=

# HAProxy (нативный systemd-сервис на хосте)
HAPROXY_CONFIG_PATH=/etc/haproxy/haproxy.cfg
HAPROXY_CERTS_DIR=/etc/letsencrypt/live

# Как часто снимать счётчики портов из iptables, секунды
PORT_SAMPLE_INTERVAL=30

# Легаси-база трафика: нужна только для разового экспорта истории в панель.
# В её каталоге лежит и traffic_config.json со списком отслеживаемых портов.
TRAFFIC_DB_PATH=/var/lib/monitoring/traffic.db

# Каталог /proc хоста, примонтированный в контейнер
HOST_PROC=/host/proc

# Тег Docker-образа агента: latest для стабильного канала, dev для dev
MON_IMAGE_TAG=latest
