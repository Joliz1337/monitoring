# Generated by tune-sysctl.sh — DO NOT EDIT.
# File descriptor and process limits, derived from host RAM/CPU.
#
# @@NOFILE_LIMIT@@ is the single FD number for the whole chain and is by
# construction <= fs.nr_open (the renderer asserts this and refuses to write
# otherwise). A value above fs.nr_open makes PAM fail, which can break login
# itself — that is why the renderer raises fs.nr_open before writing this file.

# All users
* soft nofile @@NOFILE_LIMIT@@
* hard nofile @@NOFILE_LIMIT@@
* soft nproc @@NPROC_LIMIT@@
* hard nproc @@NPROC_LIMIT@@
* soft memlock unlimited
* hard memlock unlimited

# Root user (same limits)
root soft nofile @@NOFILE_LIMIT@@
root hard nofile @@NOFILE_LIMIT@@
root soft nproc @@NPROC_LIMIT@@
root hard nproc @@NPROC_LIMIT@@
root soft memlock unlimited
root hard memlock unlimited
